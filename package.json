{
  "name": "apollo-crossword",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apollo Crossword: a crossword app with a personal dashboard, a shared puzzle library and an admin panel",
  "scripts": {
    "dev": "vite",
    "server": "npm run build:server && node dist-server/index.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/index.mjs --log-level=warning",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
